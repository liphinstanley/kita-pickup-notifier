# Copy to .env (gitignored) and fill in. deploy.sh pushes these to the Cloud Run job.
PROJECT=kita-pickup-liphin
REGION=europe-west1
BILLING_ACCOUNT=
FROM_LAT=
FROM_LON=
FROM_NAME="Home"
TO_LAT=
TO_LON=
TO_NAME="Kita"
# Daily trips name@HH:MM (time to be at the kita); one message per trip
TRIPS=drop-off@08:50,pickup@15:15
BUFFER_MIN=5
LEAD_MIN=10
# If BVG is down: "leave at <arrive-by> minus FALLBACK_MIN"
FALLBACK_MIN=20
# Kita closing days, comma separated YYYY-MM-DD
SKIP_DATES=
# Telegram bot token from @BotFather
TELEGRAM_TOKEN=
# Chat IDs to notify, comma separated (each person must tap Start on the bot first)
TELEGRAM_CHAT_IDS=
# GCS bucket for the "already sent today" date; us-central1 = always-free tier
STATE_BUCKET=
