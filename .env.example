# Copy to .env (gitignored) and fill in. deploy.sh pushes these to the Cloud Run job.
PROJECT=kita-pickup-liphin
REGION=europe-west1
BILLING_ACCOUNT=
FROM_LAT=
FROM_LON=
FROM_NAME="Home"
TO_LAT=
TO_LON=
TO_NAME="Kita"
ARRIVE_BY=15:15
BUFFER_MIN=5
LEAD_MIN=10
FALLBACK_LEAVE=14:55
# Kita closing days, comma separated YYYY-MM-DD
SKIP_DATES=
# Anyone who knows the topic can read/send: keep it long and random (openssl rand -hex 12)
NTFY_TOPIC=
